{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/skills/desktop-notify/scripts/notify.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
